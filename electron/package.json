{
  "name": "jira-git-gui",
  "version": "0.7.0",
  "description": "Jira Git GUI",
  "main": "main.js",
  "homepage": "https://caozhaoqi.github.io",
  "author": {
    "name": "caozhaoqi",
    "email": "zhaoqi.cao@icloud.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/caozhaoqi/jira-git-gui.git"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win --x64",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^32.3.3",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.jiragitgui.app",
    "productName": "JiraGitGUI",
    "publish": false,
    "directories": {
      "output": "dist-electron",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/backend",
        "to": "backend"
      }
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "${productName}-${version}-setup.${ext}"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Development",
      "maintainer": "caozhaoqi <zhaoqi.cao@icloud.com>"
    }
  }
}
