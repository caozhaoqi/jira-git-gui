# 虚拟环境
venv/
.venv/

# 运行期产物（克隆仓库 / 下载文件，含可能的敏感内容）
store/

# 运行期日志（含完整 traceback，不入库）
logs/

# Python 缓存
__pycache__/
*.pyc
*.pyo
.env
.session.json

cf_accounts.local.json
config/cf_accounts.local.json
# CF 账号自动登录后缓存的 token（仅 token，绝不存密码；首次启动自动填充）
cf_tokens.local.json
config/cf_tokens.local.json

# 运行期缓存（含拉取的文件树/内容，可能含敏感信息）
cache/
# 同步历史记录（含本地路径等，不入库）
sync_history/

# 测试：保留单测随仓库提交；含密钥的集成测试单独忽略
tests/test_integration.py
tests/.pytest_cache/

# Electron
electron/node_modules/
electron/package-lock.json
electron/dist-electron/

# Tauri
tauri/web/
tauri/src-tauri/target/
tauri/src-tauri/gen/
tauri/src-tauri/resources/backend/*
!tauri/src-tauri/resources/backend/.gitkeep

# PyInstaller 构建产物
dist/
build/__pycache__/
build/pyinstaller_*/
# 冻结后的后端二进制（由 CI / 本地构建生成，不入库；保留目录占位）
electron/resources/backend/*
!electron/resources/backend/.gitkeep

deliverables/
.workbuddy/

*.DS_Store
*.DS_Store.DS_Store

# 白名单：占位模板可提交；含真实 IP/域名的 .local 文件禁止入库
hcm_whitelist.local.json
config/hcm_whitelist.local.json

# Clash 面板默认值：模板可提交；含真实 IP 的 .local 文件禁止入库
clash_defaults.local.json
config/clash_defaults.local.json

frontend/web-react/node_modules/

web/
docs/HCM_OBJECT_BROWSER.md

.codebuddy/
.pytest_cache/

# 前端构建产物（web-react / React）：源码入库，依赖与构建产物忽略
frontend/web-react/dist/
frontend/web-react/build/
frontend/web-react/.tsbuildinfo
*.tsbuildinfo
# 旧前端子目录（已迁移到 web-react，不再维护）
frontend/web-legacy/

.workbuddy-ai/