{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JiraGitGUI",
  "version": "0.1.0",
  "identifier": "com.jiragitgui.desktop",
  "build": {
    "frontendDist": "../web",
    "devUrl": "http://127.0.0.1:8787"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/backend/*": "backend/"
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}